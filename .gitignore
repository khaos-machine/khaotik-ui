node_modules/
dist/
.DS_Store

# Per-machine Claude Code settings (permission allowlist, default mode).
# The shared toolkit under .claude/ is tracked; this file is not.
.claude/settings.local.json

# Generated by scripts/check-consumer.mjs; written and removed per run.
scripts/consumer/probe.*.ts

# Claude Code writes a backup beside settings.json when it edits session
# config, leaving an untracked file that dirties every `git status`. Two
# separate agents flagged it as an unexplained working-tree anomaly this
# session before anyone identified it. khaos-manager ignored the same artifact
# in its #259.
.claude/settings.json.bak
