// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the Composer stage's view > draws today's rendered stage, unchanged 1`] = `"<!----><!----> <!----><!----><div class="ui-composer__stage"><!----><div aria-label="Active shot" class="shot-preview rendered"><img class="shot-preview__image" src="blob:frame-1"><!----> <section class="shot-preview__direction" aria-label="Active shot direction"><div class="shot-preview__eyebrow"><i aria-hidden="true" class="ph ph-image"></i><!----><span class=""></span><span class="">Chosen frame</span></div> <h2 class=""></h2> <!----></section> <section class="shot-preview__event" aria-label="Current story event"><span class="">Action</span><p class="">Rover steps through the door.</p></section><!----></div><!----></div><!---->"`;

exports[`the Composer stage's view > leaves the planning part untouched 1`] = `"<!----><!----> <!----><section aria-label="Scene shot planning" class="scene-plan" aria-busy="false"><div class="scene-plan__heading"><span>Scene coverage</span><span>0 analysis beats</span></div> <!----> <p class="">Plan this scene’s shots from its script and analysis. Review the timing and direction before adding them to the picture track.</p> <details class=""><summary class="">Direct the plan</summary><label class="">Creative direction<textarea aria-label="Scene planning direction" rows="3" placeholder="Coverage, pacing or moments you want to emphasize…" class=""></textarea></label></details> <button class="ui-button" type="button" data-variant="primary"><!----> <!----><i aria-hidden="true" class="ph ph-sparkle"></i><!---->Plan scene shots<!----></button><!----> <!----> <small class="">Uses your text AI connection. Images are generated separately.</small><!----></section><!---->"`;
